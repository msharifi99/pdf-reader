{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": ["main", "reader-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "opener:default",
    "window-state:default"
  ]
}
